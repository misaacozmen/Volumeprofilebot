# XM MT5 Environment Configuration Template
# NOTE: .env is NOT automatically loaded by runtime processes.
# Production Windows MT5 password is NEVER stored in plaintext and is injected ONLY via DPAPI / launcher.

XM_MT5_SERVER=XMGlobal-MT5
XM_MT5_READ_ONLY_PASSWORD=
XM_MT5_TERMINAL_PATH=C:\Program Files\XM Global MT5\terminal64.exe

# Optional Telegram Watchdog Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
