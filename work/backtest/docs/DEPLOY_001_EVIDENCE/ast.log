", "variable": "$primaryError"}, {"end": 114615, "kind": "variable", "scope": "top-level", "start": 114602, "user_path": "primaryError", "variable": "$primaryError"}, {"end": 114638, "kind": "variable", "scope": "top-level", "start": 114624, "user_path": "cleanupErrors", "variable": "$cleanupErrors"}, {"end": 114712, "kind": "variable", "scope": "top-level", "start": 114698, "user_path": "cleanupErrors", "variable": "$cleanupErrors"}, {"end": 114736, "kind": "variable", "scope": "top-level", "start": 114729, "user_path": "Result", "variable": "$Result"}, {"end": 10101, "kind": "return", "scope": "function:Test-PathWithin", "start": 9829, "text": "return (\r\n        $resolvedChild.Equals($resolvedParent, [StringComparison]::OrdinalIgnoreCase) -or\r\n        $resolvedChild.StartsWith(\r\n            ($resolvedParent + [IO.Path]::DirectorySeparatorChar),\r\n            [StringComparison]::OrdinalIgnoreCase\r\n        )\r\n    )"}, {"end": 10637, "kind": "return", "scope": "function:Get-AclIdentitySid", "start": 10564, "text": "return $Identity.Translate([Security.Principal.SecurityIdentifier]).Value"}, {"end": 24371, "kind": "return", "scope": "function:Get-Super1PythonProcesses", "start": 23579, "text": "return @(\r\n        Get-CimInstance Win32_Process -ErrorAction Stop |\r\n            Where-Object {\r\n                $name = [string]$_.Name\r\n                $commandLine = [string]$_.CommandLine\r\n                $executable = [string]$_.ExecutablePath\r\n                $isPython = $name -ieq \"python.exe\" -or $name -ieq \"pythonw.exe\"\r\n                $belongsToSuper1 = (\r\n                    (-not [string]::IsNullOrWhiteSpace($commandLine) -and\r\n                        $commandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0) -or\r\n                    (-not [string]::IsNullOrWhiteSpace($executable) -and\r\n                        (Test-PathWithin -Child $executable -Parent $venvRoot))\r\n                )\r\n                $isPython -and $belongsToSuper1\r\n            }\r\n    )"}, {"end": 25783, "kind": "return", "scope": "function:Get-Super1TerminalProcesses", "start": 24941, "text": "return @($matching | ForEach-Object {\r\n        $owner = Invoke-CimMethod -InputObject $_ -MethodName GetOwner -ErrorAction Stop\r\n        if ([uint32]$owner.ReturnValue -ne 0 -or [string]::IsNullOrWhiteSpace([string]$owner.User)) {\r\n            throw \"Could not resolve the owner of Super1 terminal process $($_.ProcessId).\"\r\n        }\r\n        $account = if ([string]::IsNullOrWhiteSpace([string]$owner.Domain)) {\r\n            [string]$owner.User\r\n        } else { \"$($owner.Domain)\\$($owner.User)\" }\r\n        $ownerSid = (New-Object Security.Principal.NTAccount($account)).Translate(\r\n            [Security.Principal.SecurityIdentifier]\r\n        ).Value\r\n        [pscustomobject]@{\r\n            ProcessId = [int]$_.ProcessId\r\n            ExecutablePath = [string]$_.ExecutablePath\r\n            OwnerSid = [string]$ownerSid\r\n        }\r\n    })"}, {"end": 26053, "kind": "return", "scope": "function:Get-Super1TaskRunnerSid", "start": 25985, "text": "return [Security.Principal.SecurityIdentifier]::new($identity).Value"}, {"end": 26198, "kind": "return", "scope": "function:Get-Super1TaskRunnerSid", "start": 26066, "text": "return (New-Object Security.Principal.NTAccount($identity)).Translate(\r\n        [Security.Principal.SecurityIdentifier]\r\n    ).Value"}, {"end": 26581, "kind": "return", "scope": "function:Get-Super1ProcessOwnerSid", "start": 26569, "text": "return $null"}, {"end": 26821, "kind": "return", "scope": "function:Get-Super1ProcessOwnerSid", "start": 26809, "text": "return $null"}, {"end": 27223, "kind": "return", "scope": "function:Get-Super1ProcessOwnerSid", "start": 27083, "text": "return (New-Object Security.Principal.NTAccount($identity)).Translate(\r\n            [Security.Principal.SecurityIdentifier]\r\n        ).Value"}, {"end": 27289, "kind": "return", "scope": "function:Get-Super1ProcessOwnerSid", "start": 27277, "text": "return $null"}, {"end": 28028, "kind": "return", "scope": "function:Get-Super1RunnerProcesses", "start": 28003, "text": "return $matches.ToArray()"}, {"end": 28580, "kind": "return", "scope": "function:Get-UnexpectedSuper1RunnerProcesses", "start": 28215, "text": "return @(Get-Super1RunnerProcesses | Where-Object {\r\n        if (-not $PreserveTerminal) { return $true }\r\n        if ([string]::IsNullOrWhiteSpace([string]$_.ExecutablePath)) { return $true }\r\n        return -not [IO.Path]::GetFullPath([string]$_.ExecutablePath).Equals(\r\n            $terminal,\r\n            [StringComparison]::OrdinalIgnoreCase\r\n        )\r\n    })"}, {"end": 28318, "kind": "return", "scope": "function:Get-UnexpectedSuper1RunnerProcesses", "start": 28306, "text": "return $true"}, {"end": 28405, "kind": "return", "scope": "function:Get-UnexpectedSuper1RunnerProcesses", "start": 28393, "text": "return $true"}, {"end": 28572, "kind": "return", "scope": "function:Get-UnexpectedSuper1RunnerProcesses", "start": 28417, "text": "return -not [IO.Path]::GetFullPath([string]$_.ExecutablePath).Equals(\r\n            $terminal,\r\n            [StringComparison]::OrdinalIgnoreCase\r\n        )"}, {"end": 29925, "kind": "return", "scope": "function:Wait-Super1Stopped", "start": 29919, "text": "return"}, {"end": 30829, "kind": "return", "scope": "function:Stop-Super1RuntimeForRollback", "start": 30823, "text": "return"}, {"end": 40063, "kind": "return", "scope": "function:Get-TrustedBootstrapPythonEvidence", "start": 39772, "text": "return [pscustomobject]@{\r\n            path = $python\r\n            sha256 = $hash\r\n            signature_status = [string]$signature.Status\r\n            signer_subject = [string]$signature.SignerCertificate.Subject\r\n            product_version = $version\r\n            lock = $lock\r\n        }"}, {"end": 43528, "kind": "return", "scope": "function:Get-Super1TerminalPinEvidence", "start": 43272, "text": "return [pscustomobject]@{\r\n            path = $terminal\r\n            root = $terminalRoot\r\n            sha256 = $hash\r\n            signature_status = [string]$signature.Status\r\n            pointer = $PointerPath\r\n            lock = $terminalLock\r\n        }"}, {"end": 51164, "kind": "return", "scope": "function:Protect-Super1TerminalRuntime", "start": 50826, "text": "return [pscustomobject]@{\r\n            path = $terminal\r\n            root = $expectedTerminalRoot\r\n            sha256 = $terminalHash\r\n            signature_status = [string]$signature.Status\r\n            pointer = $PointerPath\r\n            writable_data_directories = $writableDataDirectories\r\n            lock = $terminalLock\r\n        }"}, {"end": 55459, "kind": "return", "scope": "function:Protect-Super1RuntimeConfigFiles", "start": 55434, "text": "return $results.ToArray()"}, {"end": 60629, "kind": "return", "scope": "function:Invoke-Super1OfflineValidation", "start": 60615, "text": "return $result"}, {"end": 61938, "kind": "return", "scope": "function:Assert-ReleasePythonDependencies", "start": 61899, "text": "return ($output[-1] | ConvertFrom-Json)"}, {"end": 62167, "kind": "return", "scope": "function:Get-Super1PrincipalSid", "start": 62099, "text": "return [Security.Principal.SecurityIdentifier]::new($Identity).Value"}, {"end": 62312, "kind": "return", "scope": "function:Get-Super1PrincipalSid", "start": 62180, "text": "return (New-Object Security.Principal.NTAccount($Identity)).Translate(\r\n        [Security.Principal.SecurityIdentifier]\r\n    ).Value"}, {"end": 62478, "kind": "return", "scope": "function:ConvertFrom-ScheduledTaskDuration", "start": 62455, "text": "return [TimeSpan]$Value"}, {"end": 62543, "kind": "return", "scope": "function:ConvertFrom-ScheduledTaskDuration", "start": 62492, "text": "return [Xml.XmlConvert]::ToTimeSpan([string]$Value)"}, {"end": 62599, "kind": "return", "scope": "function:ConvertFrom-ScheduledTaskDuration", "start": 62559, "text": "return [TimeSpan]::Parse([string]$Value)"}, {"end": 76880, "kind": "return", "scope": "function:New-AtomicSuper1Candidate", "start": 76751, "text": "return [pscustomobject]@{\r\n        path = $Target\r\n        state = \"CREATED_FROM_SIGNED_APP\"\r\n        sha256 = $sourceHash\r\n    }"}]}}