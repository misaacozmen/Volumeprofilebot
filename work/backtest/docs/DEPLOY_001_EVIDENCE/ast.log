ble", "scope": "top-level", "start": 175627, "user_path": "failureToReport", "variable": "$failureToReport"}, {"end": 175778, "kind": "variable", "scope": "top-level", "start": 175763, "user_path": "cleanupSummary", "variable": "$cleanupSummary"}, {"end": 175826, "kind": "variable", "scope": "top-level", "start": 175811, "user_path": "cleanupSummary", "variable": "$cleanupSummary"}, {"end": 16560, "kind": "return", "scope": "function:Resolve-ForwardIdentitySid", "start": 16490, "text": "return ([Security.Principal.SecurityIdentifier]::new($Identity)).Value"}, {"end": 16717, "kind": "return", "scope": "function:Resolve-ForwardIdentitySid", "start": 16588, "text": "return ([Security.Principal.NTAccount]$Identity).Translate(\r\n            [Security.Principal.SecurityIdentifier]\r\n        ).Value"}, {"end": 17075, "kind": "return", "scope": "function:Get-ForwardAclRuleSid", "start": 17002, "text": "return $Identity.Translate([Security.Principal.SecurityIdentifier]).Value"}, {"end": 32476, "kind": "return", "scope": "function:New-ForwardRestorePrivilegeScope", "start": 32373, "text": "return [ForwardShadowUpgrade.NativeTokenPrivileges]::EnableScoped(\r\n        \"SeRestorePrivilege\"\r\n    )"}, {"end": 40642, "kind": "return", "scope": "function:Protect-ForwardTree", "start": 40636, "text": "return"}, {"end": 46394, "kind": "return", "scope": "function:Initialize-ForwardRunnerTokenSentinel", "start": 46379, "text": "return $created"}, {"end": 48856, "kind": "return", "scope": "function:Get-ForwardRootAclSnapshot", "start": 48450, "text": "return [pscustomobject]@{\r\n        owner_sid = [string]$acl.GetOwner(\r\n            [Security.Principal.SecurityIdentifier]\r\n        ).Value\r\n        group_sid = [string]$acl.GetGroup(\r\n            [Security.Principal.SecurityIdentifier]\r\n        ).Value\r\n        access_sddl = [string]$acl.GetSecurityDescriptorSddlForm(\r\n            [Security.AccessControl.AccessControlSections]::Access\r\n        )\r\n    }"}, {"end": 60383, "kind": "return", "scope": "function:Get-ForwardAccountRights", "start": 60320, "text": "return @([ForwardShadowUpgrade.NativeAccountRights]::Get($Sid))"}, {"end": 61184, "kind": "return", "scope": "function:Get-ForwardRequiredRunnerLogonRights", "start": 60967, "text": "return @(\r\n        \"SeBatchLogonRight\",\r\n        \"SeDenyInteractiveLogonRight\",\r\n        \"SeDenyNetworkLogonRight\",\r\n        \"SeDenyRemoteInteractiveLogonRight\",\r\n        \"SeDenyServiceLogonRight\"\r\n    ) | Sort-Object"}, {"end": 62875, "kind": "return", "scope": "function:Reset-ForwardRunnerPasswordInMemory", "start": 62853, "text": "return $securePassword"}, {"end": 68741, "kind": "return", "scope": "function:Get-TrustedExecutableEvidence", "start": 68344, "text": "return [pscustomobject]@{\r\n        path = $resolved\r\n        sha256 = $hash\r\n        signature_status = [string]$signature.Status\r\n        signer_subject = if ($signature.SignerCertificate) {\r\n            [string]$signature.SignerCertificate.Subject\r\n        } else { \"\" }\r\n        product_version = [string](Get-Item -LiteralPath $resolved).VersionInfo.ProductVersion\r\n        lock = $lock\r\n    }"}, {"end": 71542, "kind": "return", "scope": "function:Get-ForwardPythonProcesses", "start": 69917, "text": "return @(\r\n        Get-CimInstance Win32_Process -ErrorAction Stop |\r\n            Where-Object {\r\n                if ($_.Name -notlike \"python*.exe\") { return $false }\r\n                $executable = [string]$_.ExecutablePath\r\n                $commandLine = [string]$_.CommandLine\r\n                $managedExecutable = $false\r\n                if (-not [string]::IsNullOrWhiteSpace($executable)) {\r\n                    $resolvedExecutable = [IO.Path]::GetFullPath($executable)\r\n                    $managedExecutable = @(\r\n                        $venvPrefixes | Where-Object {\r\n                            $resolvedExecutable.StartsWith(\r\n                                $_,\