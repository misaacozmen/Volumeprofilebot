{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-owner-declaration-v1",
  "title": "Demo broker account rotation owner declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "statement_type",
    "status",
    "declarant_role",
    "purpose",
    "rotation_date",
    "old_credential_not_used",
    "credential_values_shared"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "statement_type": {"const": "DEMO_BROKER_ACCOUNT_ROTATION_OWNER_DECLARATION_V1"},
    "status": {"const": "DECLARED"},
    "declarant_role": {"const": "OWNER"},
    "purpose": {"const": "DEMO_REPOSITORY_PUBLICATION"},
    "rotation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "old_credential_not_used": {"const": true},
    "credential_values_shared": {"const": false}
  }
}
