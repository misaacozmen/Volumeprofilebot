[Unit]
Description=Capital Demo Causal Forward Shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forwardshadow
Group=forwardshadow
WorkingDirectory=/opt/forward-shadow
EnvironmentFile=/etc/forward-shadow/capital.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/forward-shadow/.venv/bin/python scripts/run_capital_forward.py --output-root /var/lib/forward-shadow daemon
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/forward-shadow
UMask=0077

[Install]
WantedBy=multi-user.target
